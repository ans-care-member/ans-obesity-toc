<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>投与日チェック</title>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500;700&display=swap">
<style>
body { margin: 0; }
/* Layout: one narrow column, input card on top, result card below. Phone first. */
:root {
  --bg: #FAFAFA;
  --surface: #FFFFFF;
  --surface-2: #F7F5F2;
  --fg: #212121;
  --fg-sub: #616161;
  --border: #E0E0E0;
  --primary: #D93700;
  --primary-hover: #C12700;
  --primary-ink: #FFFFFF;
  --primary-soft: #FCE8E5;
  --primary-text: #E63F00;
  --ok: #008900;
  --ok-bg: #E5F4E4;
  --warn-edge: #FFB600;
  --warn-bg: #FFF8E0;
  --warn-ink: #6B4A00;
  --alert: #DB2D2F;
  --alert-bg: #FEEAED;
  --focus: #2196F3;
  --green: #008900; --green-hover: #006B00; --green-ink: #FFFFFF;
  --font: "Noto Sans JP", "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif;
  --xxs: 4px; --xs: 8px; --sm: 12px; --md: 16px; --lg: 24px; --xl: 32px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #1A1A1A; --surface: #242424; --surface-2: #2E2B28; --fg: #FAFAFA; --fg-sub: #BDBDBD;
    --border: #424242; --primary: #FF6832; --primary-hover: #FF8250; --primary-ink: #212121;
    --primary-soft: #3A2218; --primary-text: #FF8250; --ok: #5FD35C; --ok-bg: #16301A;
    --warn-edge: #FFCC17; --warn-bg: #352C0E; --warn-ink: #FFE08A; --alert: #FF7B7D; --alert-bg: #3A1B1C;
    --focus: #64B5F6; --green: #1F8A1C; --green-hover: #2A9F27; --green-ink: #FFFFFF; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #1A1A1A; --surface: #242424; --surface-2: #2E2B28; --fg: #FAFAFA; --fg-sub: #BDBDBD;
  --border: #424242; --primary: #FF6832; --primary-hover: #FF8250; --primary-ink: #212121;
  --primary-soft: #3A2218; --primary-text: #FF8250; --ok: #5FD35C; --ok-bg: #16301A;
  --warn-edge: #FFCC17; --warn-bg: #352C0E; --warn-ink: #FFE08A; --alert: #FF7B7D; --alert-bg: #3A1B1C;
  --focus: #64B5F6; --green: #1F8A1C; --green-hover: #2A9F27; --green-ink: #FFFFFF; color-scheme: dark;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { background: var(--bg); color: var(--fg); font-family: var(--font); font-weight: 500; font-size: 16px; line-height: 1.7; padding-inline: var(--md); padding-block: var(--lg) var(--xl); }
.app { max-width: 480px; margin-inline: auto; display: flex; flex-direction: column; gap: var(--md); }
h1 { font-size: 24px; line-height: 1.2; font-weight: 700; margin: 0; text-wrap: balance; }
.lead { margin: var(--xs) 0 0; font-size: 14px; line-height: 1.6; color: var(--fg-sub); }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: var(--md); display: flex; flex-direction: column; gap: var(--md); min-width: 0; }
.fields { display: grid; grid-template-columns: 1fr; gap: var(--sm); }
.field { display: flex; flex-direction: column; gap: var(--xxs); min-width: 0; }
label, .label { font-size: 12px; line-height: 1.5; font-weight: 700; color: var(--fg-sub); }
input[type="date"], input[type="time"] { font: inherit; font-size: 16px; font-weight: 500; color: var(--fg); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; height: 48px; padding-inline: var(--sm); width: 100%; min-width: 0; }
.date-row { position: relative; display: flex; align-items: center; gap: var(--xs); min-width: 0; height: 48px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); padding-inline: var(--sm); }
.date-row:focus-within { outline: 3px solid var(--focus); outline-offset: 2px; }
.date-text { flex: 1 1 auto; font-size: 16px; line-height: 1.4; font-weight: 500; font-variant-numeric: tabular-nums; pointer-events: none; }
.date-text .ph { color: var(--fg-sub); }
.dow { color: var(--primary-text); font-weight: 700; }
.cal { flex: none; color: var(--fg-sub); pointer-events: none; }
.date-row input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; border: 0; padding: 0; font-size: 16px; }
.now-line { margin: 0; font-size: 14px; line-height: 1.6; color: var(--fg-sub); font-variant-numeric: tabular-nums; }
.now-line b { color: var(--fg); font-size: 16px; }
.actions button { font-size: 15px; padding-inline: var(--xs); min-width: 0; }
.hint { font-size: 12px; line-height: 1.5; color: var(--fg-sub); margin: 0; }
.actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--xs); }
button { font-family: var(--font); font-weight: 700; font-size: 16px; line-height: 1.2; min-height: 52px; padding: var(--sm); border-radius: 8px; border: 2px solid var(--primary); cursor: pointer; display: flex; align-items: center; justify-content: center; gap: var(--xs); background: var(--surface); color: var(--primary-text); }
button[aria-pressed="true"] { background: var(--primary); color: var(--primary-ink); border-color: var(--primary); }
button:hover { border-color: var(--primary-hover); }
button[aria-pressed="true"]:hover { background: var(--primary-hover); }
:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
button svg { flex: none; }
.banner { border-radius: 8px; padding: var(--sm) var(--md); display: flex; gap: var(--sm); align-items: flex-start; border: 1px solid; }
.banner svg { flex: none; margin-top: 3px; }
.banner h2 { margin: 0; font-size: 18px; line-height: 1.4; font-weight: 700; }
.banner p { margin: var(--xxs) 0 0; font-size: 14px; line-height: 1.6; font-weight: 500; }
.banner.ok { background: var(--ok-bg); border-color: var(--ok); color: var(--fg); }
.banner.ok svg { color: var(--ok); }
.banner.warn { background: var(--warn-bg); border-color: var(--warn-edge); color: var(--fg); }
.banner.warn svg { color: var(--warn-ink); }
.banner.skip { background: var(--alert-bg); border-color: var(--alert); color: var(--fg); }
.banner.skip svg { color: var(--alert); }
.banner.info { background: var(--surface-2); border-color: var(--border); color: var(--fg); }
.banner.info svg { color: var(--fg-sub); }
.strip, .strip-today { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: var(--xxs); }
.cell { border-radius: 8px; padding: var(--xs) 0; text-align: center; display: flex; flex-direction: column; align-items: center; border: 1px solid transparent; font-variant-numeric: tabular-nums; }
.cell .w { font-size: 12px; line-height: 1.5; color: var(--fg-sub); }
.cell .n { font-size: 16px; line-height: 1.4; font-weight: 700; }
.cell .t { font-size: 10px; line-height: 1.4; font-weight: 700; }
.cell.plan { border: 2px solid var(--primary); }
.cell.plan .t { color: var(--primary-text); }
.cell.good { background: var(--ok-bg); } .cell.good .t { color: var(--ok); }
.cell.edge { background: var(--warn-bg); border-color: var(--warn-edge); } .cell.edge .t { color: var(--warn-ink); }
.cell.bad { background: var(--alert-bg); } .cell.bad .t { color: var(--alert); }
.cell.next { background: var(--primary); } .cell.next .w, .cell.next .n, .cell.next .t { color: var(--primary-ink); }
.strip-today { margin-top: calc(-1 * var(--xs)); }
.tag-today { font-size: 10px; line-height: 1.4; font-weight: 700; text-align: center; color: var(--primary-text); }
.legend { display: flex; flex-wrap: wrap; gap: var(--xs) var(--md); font-size: 12px; line-height: 1.5; color: var(--fg-sub); margin: 0; padding: 0; list-style: none; }
.legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: var(--xxs); vertical-align: -1px; border: 1px solid transparent; }
.facts { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: var(--xs) var(--md); font-size: 14px; line-height: 1.6; }
.facts dt { color: var(--fg-sub); }
.facts dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
.sub-h { margin: 0; font-size: 14px; line-height: 1.6; font-weight: 700; }
.upcoming { display: flex; flex-wrap: wrap; gap: var(--xs); margin: 0; padding: 0; list-style: none; }
.upcoming li { background: var(--surface-2); border-radius: 8px; padding: var(--xs) var(--sm); font-size: 14px; line-height: 1.6; font-weight: 700; font-variant-numeric: tabular-nums; }
.cal-link { margin: 0; font-size: 14px; line-height: 1.6; }
.btn-link { display: flex; align-items: center; justify-content: center; gap: var(--xs); min-height: 52px; padding: var(--sm); border-radius: 8px; background: var(--surface); color: var(--primary-text); border: 2px solid var(--primary); font-size: 16px; line-height: 1.2; font-weight: 700; text-decoration: none; }
.btn-link.green { background: var(--green); border-color: var(--green); color: var(--green-ink); }
.btn-link.green:hover { background: var(--green-hover); border-color: var(--green-hover); }
.btn-link:hover { border-color: var(--primary-hover); }
.pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--xs); }
.pager button { min-height: 48px; font-size: 14px; border-width: 1px; border-color: var(--border); color: var(--fg); }
.pager button:disabled { opacity: .4; cursor: default; }
.dose-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--xs); }
.dose-list li { background: var(--surface-2); border-radius: 8px; padding: var(--sm) var(--md); font-size: 16px; line-height: 1.5; font-weight: 700; font-variant-numeric: tabular-nums; }
.chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: var(--xs); }
.chips button { min-height: 56px; flex-direction: column; gap: 0; font-size: 16px; border-width: 1px; border-color: var(--border); color: var(--fg); }
.chips button small { font-size: 10px; line-height: 1.4; font-weight: 700; color: var(--fg-sub); }
.chips button[aria-pressed="true"] { border-width: 2px; border-color: var(--primary); background: var(--primary-soft); color: var(--fg); }
.chips button[aria-pressed="true"] small { color: var(--primary-text); }
.notes { margin: 0; padding-left: var(--lg); font-size: 14px; line-height: 1.6; color: var(--fg); display: flex; flex-direction: column; gap: var(--xxs); }
.foot { font-size: 12px; line-height: 1.6; color: var(--fg-sub); margin: 0; }
.foot a { color: var(--primary-text); }
@media (prefers-reduced-motion: no-preference) { button { transition: background-color .15s, border-color .15s; } }
@media (max-width: 380px) {
  body { padding-inline: var(--xs); }
  .card { padding: var(--sm); }
  h1 { font-size: 22px; }
  .date-text { font-size: 15px; }
  .cell .w { font-size: 10px; }
  .cell .n { font-size: 13px; }
  .cell .t, .tag-today { font-size: 9px; }
  .strip, .strip-today { gap: 2px; }
  .banner { padding: var(--sm); }
  .pager button { font-size: 13px; padding-inline: var(--xs); }
}
@media (min-width: 440px) { .fields.two { grid-template-columns: 1fr 1fr; } }
.sec-title { margin: 0; font-size: 18px; line-height: 1.4; font-weight: 700; }
.guide-title { margin: 0; font-size: 20px; line-height: 1.4; font-weight: 700; }
.guide { display: flex; flex-direction: column; gap: var(--md); min-width: 0; }
.dose-list .tm { margin-left: var(--xs); }
.result { display: flex; flex-direction: column; gap: var(--md); min-width: 0; }
.divider { border: 0; border-top: 1px solid var(--border); margin: 0; }
</style>

</head>
<body>
<main class="app">
  <header>
    <h1>投与日チェック</h1>
    <p class="lead">投与日の予定表と、打ち忘れ・曜日変更の目安を確認できます。</p>
  </header>

  <section class="card" aria-label="投与予定">
    <h2 class="sec-title">投与予定を教えてください</h2>
    <div class="fields two">
      <div class="field">
        <label for="planned">日付</label>
        <div class="date-row"><span class="date-text" id="plannedDow"></span><svg class="cal" width="20" height="20" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="40" y="48" width="176" height="168" rx="8"/><path d="M168 24v32M88 24v32M40 96h176"/></svg><input type="date" id="planned"></div>
      </div>
      <div class="field">
        <label for="usualTime">時刻</label>
        <input type="time" id="usualTime">
      </div>
    </div>
    <p class="hint">入っている日付と時刻は例です。ご自身の投与予定に変更してください。</p>
    <hr class="divider">
    <div class="guide" id="guide" aria-live="polite"></div>
  </section>

  <section class="card" aria-label="予定が変わったとき">
    <h2 class="sec-title">予定が変わったとき</h2>
    <p class="now-line" id="nowLine" aria-live="off"></p>
    <input type="hidden" id="today"><input type="hidden" id="nowTime">
    <div class="actions">
      <button type="button" id="btnMissed" aria-pressed="false">
        <svg width="20" height="20" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="128" cy="128" r="96"/><path d="M128 72v56l36 22"/></svg>
        打ち忘れた
      </button>
      <button type="button" id="btnChange" aria-pressed="false">
        <svg width="20" height="20" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="40" y="48" width="176" height="168" rx="8"/><path d="M168 24v32M88 24v32M40 96h176"/></svg>
        曜日を変えたい
      </button>
    </div>
    <div class="field" id="lastWrap" hidden>
      <label for="last">前回打った日</label>
      <div class="date-row"><span class="date-text" id="lastDow"></span><svg class="cal" width="20" height="20" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="40" y="48" width="176" height="168" rx="8"/><path d="M168 24v32M88 24v32M40 96h176"/></svg><input type="date" id="last"></div>
      <p class="hint">通常は予定日の7日前です。実際に打った日が違うときは直してください。前回打った時刻は、上の「時刻」と同じとして判断します。</p>
    </div>
    <div class="result" id="result" aria-live="polite" hidden></div>
  </section>

  <section class="card" aria-label="よくある質問">
    <a class="btn-link green" href="https://meowing-papyrus-d38.notion.site/ANS-39c20c9764f680bc9140ecd9572a2f38" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="128" cy="128" r="96"/><path d="M96 100a32 32 0 1 1 44 30c-8 4-12 10-12 18"/><circle cx="128" cy="184" r="3"/></svg>よくある質問はこちら</a>
  </section>

  <p class="foot">参考：本ページは電子添付文書と患者向け資料「使用し忘れた場合の対応」をもとにした目安です。2回分を一度に打たないでください。判断に迷うときは、医師に相談してください。また、初回同梱のパンフレットP18でもご確認いただくことが可能です。</p>
</main>

<script>
(function () {
  var DOW = ['日', '月', '火', '水', '木', '金', '土'];
  var MS = 86400000;
  var $ = function (id) { return document.getElementById(id); };
  var nowEl = $('nowTime'), usualEl = $('usualTime');
  var todayEl = $('today'), plannedEl = $('planned'), lastEl = $('last'), lastWrap = $('lastWrap');
  var resultEl = $('result'), btnMissed = $('btnMissed'), btnChange = $('btnChange');
  var guideEl = $('guide'), gpage = 0;
  var mode = null, lastTouched = false, picked = null;

  function parse(s) { if (!s) return null; var p = s.split('-').map(Number); return new Date(Date.UTC(p[0], p[1] - 1, p[2])); }
  function iso(d) { return d.toISOString().slice(0, 10); }
  function add(d, n) { return new Date(d.getTime() + n * MS); }
  function diff(a, b) { return Math.round((a.getTime() - b.getTime()) / MS); }
  function pt(s) { if (!s) return null; var p = s.split(':').map(Number); return p[0] * 60 + p[1]; }
  function hm(s) { return s; }
  function fmt(d) { return (d.getUTCMonth() + 1) + '/' + d.getUTCDate() + '(' + DOW[d.getUTCDay()] + ')'; }
  function p2(n) { return ('0' + n).slice(-2); }
  function dateText(d) { return d.getUTCFullYear() + '/' + p2(d.getUTCMonth() + 1) + '/' + p2(d.getUTCDate()) + '<span class="dow">（' + DOW[d.getUTCDay()] + '）</span>'; }
  function wd(d) { return DOW[d.getUTCDay()] + '曜日'; }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

  var ICON = {
    ok: '<svg width="24" height="24" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="128" cy="128" r="96"/><path d="m88 136 28 28 52-56"/></svg>',
    warn: '<svg width="24" height="24" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M114 40 24 196a16 16 0 0 0 14 24h180a16 16 0 0 0 14-24L142 40a16 16 0 0 0-28 0Z"/><path d="M128 104v48"/><circle cx="128" cy="184" r="3"/></svg>',
    skip: '<svg width="24" height="24" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="128" cy="128" r="96"/><path d="m96 96 64 64M160 96l-64 64"/></svg>',
    info: '<svg width="24" height="24" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="128" cy="128" r="96"/><path d="M120 120a8 8 0 0 1 8 8v40a8 8 0 0 0 8 8"/><circle cx="124" cy="84" r="3"/></svg>'
  };

  function banner(kind, title, body) {
    return '<div class="banner ' + kind + '" role="status">' + ICON[kind] + '<div><h2>' + title + '</h2>' + (body ? '<p>' + body + '</p>' : '') + '</div></div>';
  }
  function upcoming(start, count, label) {
    var h = '<p class="sub-h">' + label + '</p><ul class="upcoming">';
    for (var i = 0; i < count; i++) h += '<li>' + fmt(add(start, 7 * i)) + '</li>';
    return h + '</ul>';
  }

  function strip(P, T) {
    var cls = ['plan', 'good', 'good', 'good', 'edge', 'bad', 'bad', 'next'];
    var tags = ['予定', 'OK', 'OK', 'OK', '境目', '不可', '不可', '次回'];
    var h = '<div class="strip" role="img" aria-label="予定日から次回予定日までの8日間。予定日の翌日から3日後まではすぐに打てます。4日後が境目。5日後と6日後は打てません。">';
    var i, d, inRange = -1;
    for (i = 0; i < 8; i++) {
      d = add(P, i);
      if (T && diff(T, P) === i) inRange = i;
      h += '<div class="cell ' + cls[i] + '"><span class="w">' + DOW[d.getUTCDay()] + '</span><span class="n">' + d.getUTCDate() + '</span><span class="t">' + tags[i] + '</span></div>';
    }
    h += '</div>';
    h += '<div class="strip-today" aria-hidden="true">';
    for (i = 0; i < 8; i++) h += '<div class="tag-today">' + (i === inRange ? '▲今日' : '&nbsp;') + '</div>';
    h += '</div>';
    h += '<ul class="legend"><li><i style="background:var(--ok-bg);border-color:var(--ok)"></i>すぐ打てる</li><li><i style="background:var(--warn-bg);border-color:var(--warn-edge)"></i>境目(時刻による)</li><li><i style="background:var(--alert-bg);border-color:var(--alert)"></i>スキップ</li></ul>';
    return h;
  }

  function renderMissed(T, P) {
    var d = diff(T, P), N = add(P, 7), deadline = add(P, 4), h = '';
    if (d < 0) {
      h += banner('info', 'まだ予定日の前です', '予定日は ' + fmt(P) + ' です。打ち忘れではありません。');
    } else if (d <= 3) {
      h += banner('ok', '今日 ' + fmt(T) + ' に打てます', '気づいた時点ですぐに打ち、次回からは元の曜日(' + wd(N) + ')に戻します。');
    } else if (d === 4) {
      var tn = pt(nowEl.value), tu = pt(usualEl.value);
      if (tn !== null && tu !== null) {
        if (tn <= tu) h += banner('ok', '今(' + nowEl.value + ')なら打てます', '期限は今日 ' + usualEl.value + ' です。気づいた時点ですぐに打ち、次回からは元の曜日(' + wd(N) + ')に戻します。');
        else h += banner('skip', '期限の ' + usualEl.value + ' を過ぎています', '次の予定日 ' + fmt(N) + ' まで3日(72時間)を切っています。今回分は打たず、' + fmt(N) + ' に通常どおり打ってください。');
      } else {
        h += banner('warn', '今日が境目です', '「今の時刻」と「打つ予定時刻」を入力すると判定します。打つ予定時刻までなら打てます。');
      }
    } else {
      h += banner('skip', '今回はスキップしてください', '次の予定日 ' + fmt(N) + ' まで3日(72時間)を切っています。今回分は打たず、' + fmt(N) + ' に通常どおり打ってください。');
    }
    h += strip(P, T);
    h += '<dl class="facts"><dt>打つ予定だった日</dt><dd>' + fmt(P) + '</dd><dt>打てる期限</dt><dd>' + fmt(deadline) + (usualEl.value ? ' ' + usualEl.value + ' まで' : ' のいつもの時刻まで') + '</dd><dt>次の予定日</dt><dd>' + fmt(N) + '</dd></dl>';
    h += upcoming(d < 0 ? P : N, 3, 'この先の予定(毎週' + wd(P) + ')');
    return h;
  }

  function renderChange(T, P, L) {
    var min = add(L, 3), earliest = min.getTime() >= T.getTime() ? min : T;
    var capped = earliest.getTime() === T.getTime() && T.getTime() > min.getTime();
    var h = '';
    if (min.getTime() > T.getTime()) {
      h += banner('warn', '今日はまだ変更できません', '前回 ' + fmt(L) + ' から3日(72時間)あける必要があります。最短は ' + fmt(min) + (usualEl.value ? ' の ' + usualEl.value + ' 以降' : '') + ' です。');
    } else if (min.getTime() === T.getTime() && pt(nowEl.value) !== null && pt(usualEl.value) !== null && pt(nowEl.value) < pt(usualEl.value)) {
      h += banner('warn', '今日は ' + usualEl.value + ' 以降に変更できます', '前回 ' + fmt(L) + ' からちょうど3日です。今は ' + nowEl.value + ' なので、' + usualEl.value + ' まで待ってください。');
    } else {
      h += banner('ok', '今日から変更できます', '前回 ' + fmt(L) + ' から3日(72時間)以上たっています。新しい曜日を選んでください。');
    }
    var cands = [], i, c;
    for (i = 0; i < 7; i++) cands.push(add(earliest, i));
    if (!picked || cands.every(function (x) { return iso(x) !== picked; })) picked = iso(cands[0]);
    h += '<p class="sub-h">打つ日を選ぶ</p><div class="chips">';
    for (i = 0; i < 7; i++) {
      c = cands[i];
      var late = diff(c, P) > 4;
      var sub = i === 0 ? '最短' : (late ? '要確認' : '&nbsp;');
      h += '<button type="button" data-d="' + iso(c) + '" aria-pressed="' + (iso(c) === picked) + '">' + fmt(c) + '<small>' + sub + '</small></button>';
    }
    h += '</div>';
    var sel = parse(picked), notes = [];
    notes.push('前回 ' + fmt(L) + ' から ' + diff(sel, L) + '日あくため、3日(72時間)以上の条件を満たします。');
    if (diff(sel, L) === 3) notes.push('3日ちょうどの日です。前回打った時刻' + (usualEl.value ? '(' + usualEl.value + ')' : '') + 'と同じか、それ以降に打ってください。');
    if (diff(sel, P) > 4) notes.push('予定日 ' + fmt(P) + ' から4日を超えます。打ち忘れ扱いになるため、医師または薬剤師に相談してください。');
    notes.push('変更後は、新しい曜日で毎週続けます。');
    h += '<dl class="facts"><dt>新しい投与日</dt><dd>' + fmt(sel) + '</dd><dt>以降の曜日</dt><dd>毎週' + wd(sel) + '</dd></dl>';
    h += '<ul class="notes">' + notes.map(function (n) { return '<li>' + esc(n) + '</li>'; }).join('') + '</ul>';
    h += upcoming(add(sel, 7), 2, 'その後の予定');
    return h;
  }

  function ymd(d) { return d.getUTCFullYear() + p2(d.getUTCMonth() + 1) + p2(d.getUTCDate()); }
  function tfmt(t) { return t ? t.replace(':', '：') : ''; }
  function plain(d) { return d.getUTCFullYear() + '/' + p2(d.getUTCMonth() + 1) + '/' + p2(d.getUTCDate()) + '（' + DOW[d.getUTCDay()] + '）' + (usualEl.value ? tfmt(usualEl.value) : ''); }
  function stamp(d, min) { return ymd(d) + 'T' + p2(Math.floor(min / 60)) + p2(min % 60) + '00'; }
  function calUrl(start, depth) {
    var i, lines = [], tmin = pt(usualEl.value);
    for (i = 0; i < 4; i++) lines.push(plain(add(start, 7 * i)));
    var desc = '🗓️' + wd(start) + 'コース\n' + lines.join('\n');
    var dates;
    if (tmin === null) { dates = ymd(start) + '/' + ymd(add(start, 1)); }
    else {
      var em = tmin + 30, ed = start;
      if (em >= 1440) { em -= 1440; ed = add(start, 1); }
      dates = stamp(start, tmin) + '/' + stamp(ed, em);
    }
    return 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + encodeURIComponent('投与日') + '&dates=' + dates + '&ctz=Asia%2FTokyo&recur=' + encodeURIComponent('RRULE:FREQ=WEEKLY;COUNT=4') + '&details=' + encodeURIComponent(desc);
  }
  function renderGuide(T, P) {
    var gap = diff(T, P);
    var first = gap > 0 ? add(P, 7 * Math.ceil(gap / 7)) : P;
    var start = add(first, 28 * gpage), i, h = '';
    h += '<h3 class="guide-title">🗓️' + wd(P) + 'に決定！</h3>';
    h += '<ul class="dose-list">';
    for (i = 0; i < 4; i++) h += '<li>' + dateText(add(start, 7 * i)) + (usualEl.value ? '<span class="tm">' + tfmt(usualEl.value) + '</span>' : '') + '</li>';
    h += '</ul>';
    h += '<div class="pager"><button type="button" data-g="-1"' + (gpage === 0 ? ' disabled' : '') + '>前の4回分</button><button type="button" data-g="1">次の4回分</button></div>';
    h += '<p class="cal-link">Googleカレンダーをお持ちの方は登録可能です。</p>';
    h += '<a class="btn-link" href="' + calUrl(start, 2) + '" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="40" y="48" width="176" height="168" rx="8"/><path d="M168 24v32M88 24v32M40 96h176"/></svg>Googleカレンダーに登録</a>';
    return h;
  }

  function render() {
    var T = parse(todayEl.value), P = parse(plannedEl.value);
    var isChange = mode === 'change';
    lastWrap.hidden = !isChange;
    resultEl.hidden = !mode;
    btnMissed.setAttribute('aria-pressed', String(mode === 'missed'));
    btnChange.setAttribute('aria-pressed', String(isChange));
    ['planned', 'last'].forEach(function (k) { var dt = parse($(k).value); $(k + 'Dow').innerHTML = dt ? dateText(dt) : '<span class="ph">日付を選んでください</span>'; });
    if (!P) {
      guideEl.innerHTML = '<p class="hint">投与予定の日付を選ぶと、4回分の予定が表示されます。</p>';
    } else if (T) {
      guideEl.innerHTML = renderGuide(T, P);
    }
    if (!mode) return;
    if (!T || !P) { resultEl.innerHTML = banner('info', '投与予定の日付を入力してください', '上の「投与予定を教えてください」に日付を入れると結果が出ます。'); return; }
    if (isChange) {
      if (!lastTouched) lastEl.value = iso(add(P, -7));
      var L = parse(lastEl.value);
      $('lastDow').innerHTML = L ? dateText(L) : '<span class="ph">日付を選んでください</span>';
      if (!L) { resultEl.innerHTML = banner('info', '前回打った日を入力してください', ''); return; }
      resultEl.innerHTML = renderChange(T, P, L);
    } else {
      resultEl.innerHTML = renderMissed(T, P);
    }
  }

  function autoFill() {
    var n = new Date();
    if (true) todayEl.value = iso(new Date(Date.UTC(n.getFullYear(), n.getMonth(), n.getDate())));
    nowEl.value = ('0' + n.getHours()).slice(-2) + ':' + ('0' + n.getMinutes()).slice(-2);
    $('nowLine').innerHTML = '今日 <b>' + fmt(parse(todayEl.value)) + '</b> ・ 今の時刻 <b>' + nowEl.value + '</b>';
  }
  autoFill();
  var today = parse(todayEl.value);
  usualEl.value = '14:00';
  plannedEl.value = iso(add(today, -2));
  lastEl.value = iso(add(today, -9));

  [plannedEl, lastEl].forEach(function (el) {
    el.addEventListener('click', function () { try { if (el.showPicker) el.showPicker(); } catch (e) {} });
  });
  function refreshClock() { autoFill(); render(); }
  setInterval(refreshClock, 30000);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) refreshClock(); });
  usualEl.addEventListener('input', render);
  plannedEl.addEventListener('input', function () { picked = null; gpage = 0; render(); });
  lastEl.addEventListener('input', function () { lastTouched = true; picked = null; render(); });
  btnMissed.addEventListener('click', function () { mode = 'missed'; render(); });
  btnChange.addEventListener('click', function () { mode = 'change'; render(); });
  guideEl.addEventListener('click', function (e) {
    var g = e.target.closest ? e.target.closest('button[data-g]') : null;
    if (g && !g.disabled) { gpage = Math.max(0, gpage + Number(g.getAttribute('data-g'))); render(); }
  });
  resultEl.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('button[data-d]') : null;
    if (b) { picked = b.getAttribute('data-d'); render(); }
  });
  render();
})();
</script>

</body>
</html>
